<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://local.frame-home/app" version="0.6.6" viewmodes="maximized">
  <tizen:application id="nClrkHome1.FrameHome" package="nClrkHome1" required_version="5.0"/>
  <content src="index.html"/>
  <name>CleanFrame</name>
  <icon src="icon.png"/>
  <tizen:app-control>
    <tizen:src name="index.html" reload="disable"/>
    <tizen:operation name="http://tizen.org/appcontrol/operation/main"/>
  </tizen:app-control>
  <tizen:service id="nClrkHome1.Watch" on-boot="true" auto-restart="true">
    <tizen:content src="service/index.js"/>
    <tizen:name>CleanFrameStart</tizen:name>
    <tizen:description>Opens CleanFrame at startup and brings it back after a Home press</tizen:description>
  </tizen:service>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <tizen:profile name="tv-samsung"/>
  <!-- Samsung's TV platform needs these for a web service to survive in the background and
       be started at boot; background-support was previously disabled, which is the most
       likely reason on-boot never fired. Values match the one third-party launcher known to
       boot a service on Samsung TVs. -->
  <tizen:metadata key="http://samsung.com/tv/metadata/prelaunch.support" value="true"/>
  <tizen:metadata key="http://samsung.com/tv/metadata/use.network" value="false"/>
  <!-- The launcher announces app handovers to its own service on the loopback address. -->
  <access origin="http://127.0.0.1:47791" subdomains="false"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/application.info"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="enable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
