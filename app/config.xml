<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://local.frame-home/app" version="0.7.2" viewmodes="maximized">
  <tizen:application id="nClrkHome1.FrameHome" package="nClrkHome1" required_version="5.0"/>
  <content src="index.html"/>
  <name>CleanFrame</name>
  <icon src="icon.png"/>
  <tizen:app-control>
    <tizen:src name="index.html" reload="disable"/>
    <tizen:operation name="http://tizen.org/appcontrol/operation/main"/>
  </tizen:app-control>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <tizen:profile name="tv-samsung"/>
  <!-- No background service: this TV does not start one at boot and cannot tell the launcher
       when the system menu covers it, so a service could only burn memory. The measurements
       behind that are in docs/tizen5-platform-limits.md. -->
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/application.info"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
